# Optional advisory verification. Never expose this key to a browser or commit it.
METIS_API_KEY=
METIS_URL=https://metis.modelmarket.dev
METIS_ROUTE=fast
METIS_TIMEOUT_SECONDS=620

# Bounded in-memory status store for lazy Metis jobs.
METIS_MAX_JOBS=100
METIS_MAX_CONCURRENT=2
METIS_JOB_TTL_SECONDS=900

# Persistent Ed25519 identity. The Docker image overrides this to /data/provider.key.
AIMARKET_PROVIDER_IDENTITY_FILE=.aimarket/provider.key
